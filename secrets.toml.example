# Salin isi file ini ke: Streamlit Cloud > App > Settings > Secrets
# (untuk pemakaian lokal: simpan sebagai .streamlit/secrets.toml, JANGAN di-commit ke GitHub)

# Connection string dari Neon: Dashboard > Connect > pilih "Pooled connection" > salin.
DATABASE_URL = "postgresql://NEON_USER:NEON_PASSWORD@ep-xxxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Opsional: password sederhana untuk membuka aplikasi
# APP_PASSWORD = "ganti-dengan-password-tim"
